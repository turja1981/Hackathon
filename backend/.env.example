# =============================================================================
# Life Sciences AI - Backend Environment Configuration
# Copy to .env and fill in your values
# =============================================================================

# --- LLM API Keys ---
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- LiteLLM Routing ---
# Primary model used for most requests (cost-optimized)
LITELLM_PRIMARY_MODEL=gpt-4o
# Fallback model when primary is unavailable or rate-limited
LITELLM_FALLBACK_MODEL=gemini/gemini-1.5-pro
# Summary/hypothesis tasks get routed to this model (higher capability)
LITELLM_REASONING_MODEL=gpt-4o
# Enable LiteLLM response caching (strongly recommended for P99 targets)
LITELLM_CACHE_ENABLED=true
LITELLM_CACHE_TTL=3600
# Max tokens per LLM call
LITELLM_MAX_TOKENS=2048
# LLM temperature (0 = deterministic, 1 = creative)
LITELLM_TEMPERATURE=0.7

# --- Embedding Configuration ---
# Use "all-MiniLM-L6-v2" (no API key needed) or "text-embedding-3-small" (OpenAI)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# --- FAISS Vector Store ---
FAISS_INDEX_PATH=./data/faiss_index
# Number of candidates retrieved before reranking
MAX_RETRIEVED_DOCS=10
# Top-K docs passed to LLM after reranking
RERANK_TOP_K=5

# --- Server ---
HOST=0.0.0.0
PORT=8000
WORKERS=4
LOG_LEVEL=info

# --- CORS ---
FRONTEND_URL=http://localhost:3000

# --- Feature Flags ---
# When true, returns mock responses without calling LLM (useful for demos without API keys)
MOCK_LLM_MODE=false
