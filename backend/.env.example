# =============================================================================
# BioMind AI — Backend Environment Configuration
# Copy to .env and fill in your values.
# Set LLM_PROVIDER and EMBEDDING_PROVIDER first, then configure only the
# matching API keys. All other provider sections can be left blank.
# =============================================================================

# =============================================================================
# PROVIDER SELECTION  (required)
# =============================================================================
LLM_PROVIDER=genailab        # genailab | openai | gemini | mock
EMBEDDING_PROVIDER=genailab  # genailab | openai | local

# =============================================================================
# TCS GenAI Lab MaaS  (use when LLM_PROVIDER=genailab or EMBEDDING_PROVIDER=genailab)
# =============================================================================
GENAILAB_API_KEY=your_genailab_api_key_here
GENAILAB_API_BASE=https://genailab.tcs.in/

# --- Primary model: OpenAI-compatible endpoint (no azure/ prefix needed) ---
# Options: genailab-maas-gpt-4o | genailab-maas-gpt-35-turbo
#          genailab-maas-DeepSeek-V3-0324 | gemini-2.5-flash | gemini-2.5-pro
#          gemini-2.5-flash-lite | gemini-2.0-flash-001 | gemini-3-pro-preview
LITELLM_PRIMARY_MODEL=genailab-maas-gpt-4o

# --- Reasoning model (used for hypothesis + summarization agents) ---
# Options: same as PRIMARY above, or genailab-maas-DeepSeek-V3-0324 for deeper reasoning
LITELLM_REASONING_MODEL=genailab-maas-gpt-4o

# --- Azure fallback model (used when primary/reasoning fail) ---
# These are Azure-format deployments on GenAI Lab; keep the azure/ prefix.
# Options: azure/genailab-maas-gpt-5-mini | azure/genailab-maas-gpt-4.1
#          azure/genailab-maas-gpt-4.1-mini | azure/genailab-maas-gpt-4.1-nano
#          azure/genailab-maas-gpt-4o-mini
LITELLM_AZURE_FALLBACK_MODEL=azure/genailab-maas-gpt-5-mini

# --- Azure AI models (optional, for large open-source models) ---
# azure_ai/genailab-maas-DeepSeek-R1
# azure_ai/genailab-maas-Llama-4-Maverick-17B-128E-Instruct-FP8
# azure_ai/genailab-maas-Llama-3.3-70B-Instruct
# azure_ai/genailab-maas-Llama-3.2-90B-Vision-Instruct
# azure_ai/genailab-maas-Phi-4-reasoning
# azure_ai/genailab-maas-Phi-3.5-vision-instruct

# --- API version for azure/ and azure_ai/ prefixed model calls ---
LITELLM_API_VERSION=2024-06-01

# --- Embedding model (Azure-format on GenAI Lab; keep the azure/ prefix) ---
# Options: azure/genailab-maas-text-embedding-3-large
EMBEDDING_MODEL=azure/genailab-maas-text-embedding-3-large

# =============================================================================
# Direct OpenAI  (use when LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai)
# Leave blank if using GenAI Lab
# =============================================================================
OPENAI_API_KEY=

# Models: gpt-4o | gpt-4o-mini | gpt-4.1 | gpt-4.1-mini | o3-mini
# LITELLM_PRIMARY_MODEL=gpt-4o
# LITELLM_REASONING_MODEL=gpt-4o
# EMBEDDING_MODEL=text-embedding-3-large

# =============================================================================
# Direct Google Gemini  (use when LLM_PROVIDER=gemini)
# Leave blank if using GenAI Lab
# =============================================================================
GEMINI_API_KEY=

# Models: gemini-2.5-pro | gemini-2.5-flash | gemini-2.0-flash-001
# LITELLM_PRIMARY_MODEL=gemini-2.5-pro
# LITELLM_REASONING_MODEL=gemini-2.5-pro

# =============================================================================
# LiteLLM behaviour
# =============================================================================
LITELLM_CACHE_ENABLED=true
LITELLM_CACHE_TTL=3600
LITELLM_MAX_TOKENS=2048
LITELLM_TEMPERATURE=0.7

# =============================================================================
# Embedding device (only used when EMBEDDING_PROVIDER=local)
# =============================================================================
EMBEDDING_DEVICE=cpu

# =============================================================================
# FAISS Vector Store
# Delete ./data/faiss_index/ and restart if you change EMBEDDING_MODEL.
# =============================================================================
FAISS_INDEX_PATH=./data/faiss_index
MAX_RETRIEVED_DOCS=10
RERANK_TOP_K=5

# =============================================================================
# Server
# =============================================================================
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000

# =============================================================================
# PubMed / NCBI E-utilities  (live paper fetching per search query)
# PUBMED_ENABLED=true  → each search fetches fresh papers from PubMed (recommended)
# PUBMED_ENABLED=false → search only in the pre-loaded static dataset
# PUBMED_API_KEY is optional; free registration at https://www.ncbi.nlm.nih.gov/account/
#   gives 10 req/sec instead of 3 req/sec
# =============================================================================
PUBMED_ENABLED=true
PUBMED_API_KEY=
PUBMED_MAX_RESULTS=20

# =============================================================================
# Feature Flags
# MOCK_LLM_MODE=true  →  demo without any API key (pre-built responses)
# =============================================================================
MOCK_LLM_MODE=false

# =============================================================================
# Network
# DISABLE_SSL_VERIFY=true  →  disable certificate verification
# (use on corporate networks with SSL inspection, e.g. TCS VPN)
# =============================================================================
DISABLE_SSL_VERIFY=false
