# =============================================================================
# Life Sciences AI - Backend Environment Configuration
# Copy to .env and fill in your values
# =============================================================================

# =============================================================================
# OPTION A: TCS GenAI Lab MaaS (recommended for hackathon)
# One API key gives access to GPT-4o, Gemini 2.5, DeepSeek, Llama 4, etc.
# =============================================================================
GENAILAB_API_KEY=your_genailab_api_key_here
GENAILAB_API_BASE=https://genailab.tcs.in/

# --- Primary model (used for search reranking, general queries) ---
# Options: genailab-maas-gpt-4o | genailab-maas-gpt-4.1 | genailab-maas-gpt-5-mini
LITELLM_PRIMARY_MODEL=genailab-maas-gpt-4o

# --- Fallback model (used when primary fails or for cost optimisation) ---
# Options: gemini-2.5-flash | gemini-2.0-flash-001 | gemini-2.5-flash-lite
LITELLM_FALLBACK_MODEL=gemini-2.5-flash

# --- Reasoning model (used for summarization + hypothesis generation) ---
# Options: genailab-maas-gpt-4o | genailab-maas-DeepSeek-V3-0324 | azure_ai/genailab-maas-Llama-4-Maverick-17B-128E-Instruct-FP8
LITELLM_REASONING_MODEL=genailab-maas-gpt-4o

# =============================================================================
# OPTION B: Direct OpenAI (if not using GenAI Lab)
# Leave blank if GENAILAB_API_KEY is set — GenAI Lab takes priority
# =============================================================================
OPENAI_API_KEY=

# =============================================================================
# OPTION C: Direct Google Gemini (if not using GenAI Lab)
# =============================================================================
GEMINI_API_KEY=

# =============================================================================
# LiteLLM Caching
# =============================================================================
LITELLM_CACHE_ENABLED=true
LITELLM_CACHE_TTL=3600
LITELLM_MAX_TOKENS=2048
LITELLM_TEMPERATURE=0.7

# =============================================================================
# Embeddings  (default: Azure OpenAI via GenAI Lab — no HuggingFace download)
# USE_API_EMBEDDINGS=true  → Azure OpenAI / GenAI Lab (recommended)
# USE_API_EMBEDDINGS=false → local sentence-transformers (requires HuggingFace)
# If you change EMBEDDING_MODEL, delete ./data/faiss_index to force a rebuild.
# =============================================================================
EMBEDDING_MODEL=openai/genailab-maas-text-embedding-3-large
EMBEDDING_DEVICE=cpu
USE_API_EMBEDDINGS=true

# =============================================================================
# FAISS Vector Store
# =============================================================================
FAISS_INDEX_PATH=./data/faiss_index
MAX_RETRIEVED_DOCS=10
RERANK_TOP_K=5

# =============================================================================
# Server
# =============================================================================
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# =============================================================================
# CORS
# =============================================================================
FRONTEND_URL=http://localhost:3000

# =============================================================================
# Feature Flags
# Set MOCK_LLM_MODE=true to demo without any API key (uses pre-built responses)
# =============================================================================
MOCK_LLM_MODE=false

# =============================================================================
# Network / Corporate proxy
# Set DISABLE_SSL_VERIFY=true on corporate networks with SSL inspection (e.g. TCS)
# This disables certificate verification for outbound HTTPS API calls.
# =============================================================================
DISABLE_SSL_VERIFY=false
